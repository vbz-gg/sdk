{
  "name": "@vbz-gg/sdk",
  "version": "0.7.3",
  "type": "module",
  "description": "Build a game that runs on vbz.gg: its rules code and the page module a studio's page loads, the checks, a page's client and host for the platform, and a harness that runs it all on your laptop",
  "license": "MIT",
  "author": "Ramesh Nair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbz-gg/sdk.git",
    "directory": "packages/sdk"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "templates",
    "!templates/game/dist",
    "!templates/game/node_modules",
    "skill/vbz-game",
    "README.md"
  ],
  "exports": {
    "./api": {
      "development": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./build": {
      "development": "./src/build/index.ts",
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./game": {
      "development": "./src/game/index.ts",
      "types": "./dist/game/index.d.ts",
      "default": "./dist/game/index.js"
    },
    "./harness": {
      "development": "./src/harness/index.ts",
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./host": {
      "development": "./src/host/index.ts",
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./platform": {
      "development": "./src/platform/index.ts",
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./serve": {
      "development": "./src/serve/index.ts",
      "types": "./dist/serve/index.d.ts",
      "default": "./dist/serve/index.js"
    }
  },
  "peerDependencies": {
    "@clockwork2/engine": ">=0.10.0 <0.11.0"
  },
  "bin": {
    "vbz": "dist/cli/index.js"
  }
}
